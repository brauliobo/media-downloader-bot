# Worker of the tgbot (Telegram Bot API) queue; see media-downloader-tdbot-worker@.service.
#   systemctl enable --now media-downloader-tgbot-worker@{1..2}
[Unit]
Description=media-downloader-bot tgbot worker %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
SyslogIdentifier=mdb-tgbot-worker-%i
User=mdb
Nice=19
Slice=media-downloader-workers.slice
LimitNOFILE=1001001
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

WorkingDirectory=/srv/media-downloader-worker
ReadWritePaths=/srv/media-downloader-worker
Environment=HOME=/srv/media-downloader-worker
Environment=SYSTEMD_INSTANCE=%i
Environment=TMPDIR=/tmp/media-downloader/work-tg

Environment=BUNDLE_DEPLOYMENT=true
Environment=BUNDLE_FROZEN=false
Environment=RAILS_ENV=production
Environment=DB=1
Environment=THREADS=10
Environment=CUDA_VISIBLE_DEVICES=1
# The tgbot's service (BOT_HTTP of media-downloader-tgbot.service); its BOT_HTTP_TOKEN is in the environment file (root:mdb 0640).
Environment=BOT_HTTP=http://127.0.0.1:1180
EnvironmentFile=/etc/media-downloader/tgbot-worker.env
ExecStart=/usr/local/rvm/wrappers/ruby-3.4.4/bundle exec bin/worker

ExecReload=/bin/kill -USR2 $MAINPID
KillMode=mixed
KillSignal=SIGTERM
Environment=WORKER_DRAIN_TIMEOUT=540
TimeoutStopSec=660

# Autoscaling (Worker::Scaler, started by the tgbot when it has WORKER_MAX): instances up to WORKER_MIN stay, the ones above it are started
# when jobs wait and leave, with status 75 (not restarted), after WORKER_IDLE_EXIT seconds without a job.
Environment=WORKER_MIN=2
Environment=WORKER_IDLE_EXIT=120
SuccessExitStatus=75
RestartPreventExitStatus=75

Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
