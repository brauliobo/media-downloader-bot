// /etc/polkit-1/rules.d/: lets the bots (user mdb) start worker instances, which is all their scaler (Worker::Scaler) does.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" && subject.user == "mdb" &&
      action.lookup("verb") == "start" &&
      /^media-downloader-(td|tg)bot-worker@\d+\.service$/.test(action.lookup("unit"))) {
    return polkit.Result.YES;
  }
});
