#!/usr/bin/env ruby

require 'json'
require 'tmpdir'
require 'uri'

source_url = ARGV.first if ARGV.first&.match?(%r{\Ahttps?://}i)
arguments = ARGV.drop(source_url ? 1 : 0).filter_map do |argument|
  key, value = argument.split('=', 2)
  [key.tr('-', '_').to_sym, value]
end
opts = arguments.reject { |key, _value| key == :case }.to_h

if opts.key?(:help)
  puts <<~USAGE
    Usage: bin/voice_clone_eval [URL] key=value ...

    Inputs:
      URL                 download and extract the voice reference
      text=TEXT or text_file=PATH (optional with URL)
      lang=LANG (optional with URL; detected automatically)
      reference=PATH      use an existing reference instead of URL extraction
      ref_text=TEXT or ref_text_file=PATH
      comparison=PATH

    Cases may be repeated. A case is NAME[:reference][:parameter=value ...].
    Examples:
      case=baseline
      case=raw-default:reference
      case=guidance-1:reference:guidance=1

    Optional:
      repeats=N transcription=false embedding=false
      reference_filter=raw|quality|clone
      whisper_url=URL embedding_python=PATH embedding_model=PATH
      embedding_provider=NAME embedding_threads=N
  USAGE
  exit
end

def read_value(path)
  path && File.read(File.expand_path(path)).strip
end

def enabled?(value, default: true)
  return default if value.nil?

  !%w[0 false no off].include?(value.to_s.downcase)
end

def parameter_value(value)
  case value
  when 'true' then true
  when 'false' then false
  when /\A-?\d+\z/ then value.to_i
  when /\A-?(?:\d+\.\d*|\d*\.\d+)\z/ then value.to_f
  else value
  end
end

def evaluation_case(value)
  parts = value.to_s.split(':')
  name = parts.shift
  reference = %w[reference clone].include?(parts.first)
  parts.shift if reference
  parameters = parts.each_with_object({}) do |part, result|
    key, parameter = part.split('=', 2)
    raise ArgumentError, "invalid case parameter: #{part}" if parameter.nil? || key.empty?

    result[key.to_sym] = parameter_value(parameter)
  end
  VoiceClone::Case.new(name: name, reference: reference, parameters: parameters)
end

text = opts[:text] || read_value(opts[:text_file])
language = opts[:lang] || opts[:language]
reference_audio = opts[:reference] || opts[:reference_audio]
reference_text = opts[:ref_text] || read_value(opts[:ref_text_file]) ||
  opts[:reference_text] || read_value(opts[:reference_text_file])
raise ArgumentError, 'output= is not supported; results are written to stdout' if opts[:output] || opts[:output_dir]

output_dir = Dir.mktmpdir('voice-clone-eval-')
repeats = opts.fetch(:repeats, 1).to_i
reference_filter = (opts[:reference_filter] || (source_url ? 'quality' : 'raw')).to_sym

require_relative '../lib/boot'
require_relative '../lib/tts'
require_relative '../lib/voice_reference'
require_relative '../lib/voice_clone'

Subtitler::WhisperCpp.api = URI.parse(opts[:whisper_url]) if opts[:whisper_url]
transcriber = VoiceReference::Transcriber.new(cache_dir: File.join(output_dir, 'transcripts'))

if source_url
  raise ArgumentError, 'use either a URL or reference=PATH, not both' if reference_audio

  reference_path = File.join(output_dir, 'reference.wav')
  reference = VoiceReference.from_url(
    url: source_url, output: reference_path, language: language, transcriber: transcriber,
    reference_filter: reference_filter
  )
  reference_audio = reference_path
  reference_text ||= reference.text
  language ||= reference.validation.dig(:transcript, :language)
end
text ||= reference_text
raise ArgumentError, 'provide a URL or text=TEXT or text_file=PATH' if text.to_s.empty?
language ||= 'en'
comparison_audio = opts[:comparison] || opts[:comparison_audio] || reference_audio

case_values = arguments.filter_map { |_key, value| value if _key == :case }
case_values.concat(opts[:cases].split(',')) if opts[:cases]
case_values = ['baseline'] if case_values.empty?
case_values << 'reference:reference' if reference_audio && case_values == ['baseline']
cases = case_values.map { |value| evaluation_case(value) }

transcriber = nil unless enabled?(opts[:transcription])
embedding_scorer = if enabled?(opts[:embedding]) && comparison_audio
  VoiceClone::EmbeddingScorer.new(
    python:      opts[:embedding_python],
    model:       opts[:embedding_model],
    provider:    opts[:embedding_provider],
    num_threads: opts[:embedding_threads]
  )
end

report = VoiceClone::Evaluator.new(
  output_dir: output_dir,
  transcriber: transcriber,
  embedding_scorer: embedding_scorer
).run(
  text: text,
  language: language,
  cases: cases,
  reference_audio: reference_audio,
  reference_text: reference_text,
  comparison_audio: comparison_audio,
  repeats: repeats
)

puts JSON.pretty_generate(report)
exit(report.fetch(:results).any? { |result| result[:success] } ? 0 : 1)
