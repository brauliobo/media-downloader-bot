#!/usr/bin/env ruby

require 'json'
require_relative '../lib/boot'
require_relative '../lib/voice_reference'

opts = ARGV.to_h do |arg|
  key, value = arg.split('=', 2)
  [key.tr('-', '_').to_sym, value]
end

output      = File.expand_path(opts.fetch(:output))
language    = opts[:language] || 'en'
filter      = opts.fetch(:reference_filter, 'raw').to_sym

if opts[:url]
  candidate = VoiceReference.from_url(
    url: opts.fetch(:url), output: output, language: language, reference_filter: filter
  )
  puts JSON.pretty_generate(candidate.to_h)
  exit
end

source      = File.expand_path(opts.fetch(:source))
audio_files = if opts[:quality_report]
  report = JSON.parse(File.read(File.expand_path(opts[:quality_report])), symbolize_names: true)
  limit = opts.fetch(:top, report.fetch(:recordings).size).to_i
  raise ArgumentError, 'top must be positive' unless limit.positive?

  report.fetch(:recordings).first(limit).map { |recording| recording.fetch(:path) }
else
  Dir[File.join(source, '*.{flac,m4a,mp3,ogg,wav,webm}')]
end
transcriber = VoiceReference::Transcriber.new(cache_dir: opts[:cache])
strict      = opts.key?(:strict) ? opts[:strict].to_s != '0' : filter == :raw
selector    = VoiceReference::Selector.new(language: language, strict: strict)
builder     = VoiceReference::Builder.new(
  transcriber: transcriber, selector: selector, language: language, reference_filter: filter
)

candidate = builder.build(audio_files: audio_files, output: output)
puts JSON.pretty_generate(candidate.to_h)
