[Unit]
Description=Demucs voice separation backend on GPU 1
After=network-online.target
Wants=network-online.target

[Service]
User=braulio
Nice=19
UMask=0077

WorkingDirectory=/home/braulio/Projects/demucs
Environment=CUDA_VISIBLE_DEVICES=1
Environment=DEMUCS_DEVICE=cuda
Environment=DEMUCS_MODEL=htdemucs
Environment=HF_HOME=/var/cache/voice-separator-demucs/huggingface
Environment=TORCH_HOME=/var/cache/voice-separator-demucs/torch
Environment=PYTHONDONTWRITEBYTECODE=1
CacheDirectory=voice-separator-demucs
RuntimeDirectory=voice-separator-demucs
ExecStart=/home/braulio/Projects/demucs/runtime/bin/uvicorn demucs_service:app --app-dir /home/braulio/Projects/media-downloader-bot/services/voice_separation --host 127.0.0.1 --port 8084 --workers 1
ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 300 --retry-delay 2 --retry-connrefused --retry-all-errors --retry-max-time 600 --max-time 2 http://127.0.0.1:8084/health/ready

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

Restart=on-failure
RestartSec=30
TimeoutStartSec=12min
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
