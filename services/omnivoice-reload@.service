[Unit]
Description=Reload OmniVoice GPU %i after source changes
RequiresMountsFor=/srv/OmniVoice
After=network-online.target

[Service]
SyslogIdentifier=omnivoice-reload-gpu%i
Type=oneshot
ExecStart=/usr/local/libexec/omnivoice-reload %i
StateDirectory=omnivoice-reload
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
