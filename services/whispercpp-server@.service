[Unit]
Description=whisper.cpp transcription backend on GPU %i
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/whisper.cpp
StopWhenUnneeded=yes

[Service]
SyslogIdentifier=whisper-gpu%i
User=braulio
Nice=19
UMask=0077

WorkingDirectory=/run/whispercpp-server-%i
RuntimeDirectory=whispercpp-server-%i
RuntimeDirectoryMode=0700
Environment=LD_LIBRARY_PATH=/srv/whisper.cpp/runtime
ExecStart=@/srv/whisper.cpp/runtime/whisper-server whisper-gpu%i \
  --model /srv/whisper.cpp/models/ggml-large-v3-turbo.bin \
  --vad --vad-model /srv/whisper.cpp/models/ggml-silero-v6.2.0.bin \
  --host 127.0.0.1 --port 828%i --threads 16 -l auto --device %i --convert
ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 90 --retry-delay 1 --retry-connrefused --retry-all-errors --retry-max-time 90 --max-time 2 http://127.0.0.1:828%i/health

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

Restart=on-failure
RestartSec=30
TimeoutStartSec=2min
TimeoutStopSec=2min
